{
  "id": "parity-box-z",
  "description": "Synthetic 9-node box on isolators, Z random excitation. Golden values written by testdata/generate/make_parity_fixture.py from the Python pipeline, so this checks that the two implementations agree (and do not drift), not that either is right; correctness against an exact solution is checked by the analytic benchmark.",
  "input": "data/parity",
  "options": {"df": 4.0, "band": [20.0, 450.0]},
  "expected": "data/parity/expected.mat",
  "checks": [
    {"quantity": "nfft",       "rtol": 0,     "atol": 0,     "atol_fullscale": 0},
    {"quantity": "n_avg",      "rtol": 0,     "atol": 0,     "atol_fullscale": 0},
    {"quantity": "f",          "rtol": 1e-12, "atol": 0,     "atol_fullscale": 0},
    {"quantity": "T",          "rtol": 1e-10, "atol": 1e-12, "atol_fullscale": 1e-12},
    {"quantity": "coh",        "rtol": 0,     "atol": 1e-10, "atol_fullscale": 0},
    {"quantity": "Gbb",        "rtol": 1e-10, "atol": 0,     "atol_fullscale": 0},
    {"quantity": "Gxx",        "rtol": 1e-10, "atol": 0,     "atol_fullscale": 1e-12},
    {"quantity": "T_rel",      "rtol": 1e-10, "atol": 1e-12, "atol_fullscale": 1e-12},
    {"quantity": "T_el",       "rtol": 1e-9,  "atol": 1e-11, "atol_fullscale": 1e-12},
    {"quantity": "disp_el",    "rtol": 1e-9,  "atol": 1e-11, "atol_fullscale": 1e-12},
    {"quantity": "rigid_R",    "rtol": 0,     "atol": 1e-11, "atol_fullscale": 1e-12},
    {"quantity": "peak_index", "rtol": 0,     "atol": 0,     "atol_fullscale": 0},
    {"quantity": "peak_f",     "rtol": 1e-12, "atol": 0,     "atol_fullscale": 0},
    {"quantity": "peak_mpc",   "rtol": 1e-7,  "atol": 1e-9,  "atol_fullscale": 0},
    {"quantity": "peak_coh",   "rtol": 1e-9,  "atol": 1e-12, "atol_fullscale": 0}
  ]
}
